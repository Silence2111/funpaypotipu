# ──────────────────────────────────────────────────────────────
# GameMarket — пример конфигурации. Скопируйте в .env и заполните.
# ──────────────────────────────────────────────────────────────

# Среда
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://gamemarket:gamemarket@localhost:5432/gamemarket?schema=public

# Redis (кэш / очереди / pub-sub)
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth / JWT (сгенерируйте свои секреты: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Шифрование чувствительных данных (envelope encryption KEK)
DATA_ENCRYPTION_KEY=change-me-32-bytes-base64

# Публичный базовый URL API для отдачи картинок лотов (обычно = адрес API снаружи).
# Пусто → картинки резолвятся относительным путём (работает только при общем домене).
PUBLIC_ASSET_BASE=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gamemarket
# Без S3_ENDPOINT файлы лежат на диске сервера (по умолчанию .data/uploads);
# off — хранилище выключено. Ссылки на файлы подписываются этим ключом
# (по умолчанию — DATA_ENCRYPTION_KEY).
# STORAGE_DIR=.data/uploads
# STORAGE_SIGNING_SECRET=

# Поиск (Meilisearch). Если MEILI_URL пуст — поиск на Postgres (fallback).
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me

# Платежи
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-webhook-secret

# Таймеры сделок и выплаты (мс / дни)
ORDER_AUTO_CONFIRM_TTL_MS=259200000   # 72ч — авто-подтверждение после выдачи
ORDER_PAYMENT_TTL_MS=1800000          # 30мин — авто-истечение неоплаченного
ORDER_SWEEP_INTERVAL_MS=60000         # период прогона таймеров
PAYOUT_NEWBIE_HOLD_DAYS=3             # холд выплат для новичков
PROMO_DAY_PRICE=9900                  # сутки продвижения лота с баланса, копейки (99 ₽)

# Почта (локально — MailHog; в проде — боевой SMTP). Пусто → почта выключена.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gamemarket.local

# Адрес сайта — для ссылок в письмах и Telegram.
WEB_URL=http://localhost:3000

# Telegram-бот уведомлений. Пусто → бот выключен, настройки показывают
# «не подключён». Вебхук: POST https://api.telegram.org/bot<TOKEN>/setWebhook
#   url=<адрес API>/api/telegram/webhook  secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Вход через сервисы. Кнопка появляется, только когда заданы ключи.
# Telegram — тот же бот, что для уведомлений; домен сайта задаётся боту
#   в BotFather командой /setdomain. TELEGRAM_LOGIN=off убирает кнопку входа.
# Google — console.cloud.google.com → Credentials → OAuth client (Web).
# VK ID — id.vk.com → приложение «Веб». Секрет VK необязателен (вход по PKCE).
# Адрес возврата у сервиса: <API_PUBLIC_URL>/api/auth/oauth/google/callback
#   и <API_PUBLIC_URL>/api/auth/oauth/vk/callback.
# API_PUBLIC_URL — адрес API снаружи; пусто → API_URL.
TELEGRAM_LOGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
API_PUBLIC_URL=

# Пуш-уведомления (Web Push). Ключи VAPID: npx web-push generate-vapid-keys.
# Пусто → ключи создаются при первом запуске и хранятся в базе (закрытый —
# зашифрованным DATA_ENCRYPTION_KEY). Смена ключей отключает все подписки.
# WEB_PUSH=off выключает пуши.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@gamemarket.local

# Антивирус (ClamAV). Пусто → эвристика (EICAR + лимит размера).
CLAMAV_HOST=
CLAMAV_PORT=3310
ATTACHMENT_MAX_BYTES=20971520
