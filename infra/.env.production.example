# Прод GameMarket на одном VPS — infra/compose.prod.yaml. Инструкция — docs/12-deploy.md.
#   cp infra/.env.production.example infra/.env.production && nano infra/.env.production
# Файл с секретами в репозиторий не попадает (.gitignore). Пустые строки — выключено.

# ── Обязательно ──────────────────────────────────────────────────────────
# Адрес сайта и API — один. https://домен — Caddy сам получит сертификат
# (DNS-запись A на этот сервер, открытые 80 и 443).
PUBLIC_URL=https://example.ru

# Секреты: каждый — свой, `openssl rand -hex 32`. С пустыми или короткими
# API в проде не запускается. DATA_ENCRYPTION_KEY шифрует ключи товаров и
# реквизиты выплат: потеряете — их не расшифровать; меняется только с
# перешифровкой.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DATA_ENCRYPTION_KEY=
# Подпись ссылок на файлы; пусто — DATA_ENCRYPTION_KEY.
STORAGE_SIGNING_SECRET=

# ── Платежи — ЮKassa (часть 107) ────────────────────────────────────────
# Без ключей ЮKassa оплата не работает. PAYMENT_PROVIDER=mock — заглушка,
# подтверждает оплату без денег: в бою — только для показа, осознанно.
PAYMENT_PROVIDER=yookassa
MOCK_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чеки по 54-ФЗ: on — ЮKassa передаёт чек; ставка НДС и признак предмета расчёта.
YOOKASSA_RECEIPTS=
YOOKASSA_VAT_CODE=
YOOKASSA_PAYMENT_SUBJECT=
# Выплаты продавцам через ЮKassa; пусто — выплаты вручную сотрудником финансов.
PAYOUT_PROVIDER=
YOOKASSA_PAYOUT_AGENT_ID=
YOOKASSA_PAYOUT_SECRET_KEY=
YOOKASSA_PAYOUT_CARDS=
YOOKASSA_PAYOUT_WIDGET_URL=

# ── Почта — help@<домен> в Яндекс 360 (_система/почта) ──────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Вход через Яндекс ID и VK ID (Google нельзя — 149-ФЗ, ст. 10.6) ─────
# Адреса возврата: <PUBLIC_URL>/api/auth/oauth/yandex/callback и …/vk/callback.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ── Telegram: уведомления, вход, бот продавца ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LOGIN=

# ── Пуши: пусто — ключи создаются при первом запуске и хранятся в базе ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Бэкап и сторож ──────────────────────────────────────────────────────
# Куда класть ночные бэкапы на сервере и сколько дней хранить. Копия вне
# сервера — обязательно, см. docs/12-deploy.md.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Копия вне сервера — любое S3-совместимое хранилище: Яндекс Object Storage
# (https://storage.yandexcloud.net, регион ru-central1), Timeweb, Selectel…
# Бакет — приватный; ключ — с доступом только к этому бакету (запись, чтение
# и удаление старых копий). Пусто — копии нет.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=gamemarket
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_KEEP_DAYS=30
# Бэкап старше стольких часов — сообщение сторожа.
BACKUP_MAX_AGE_H=26
# Telegram для сообщений «упал / поднялся»: токен своего бота и чат.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ── Необязательно ───────────────────────────────────────────────────────
# Файлы в S3 вместо тома на сервере.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=gamemarket
# ClamAV для вложений; без него — проверка по сигнатурам в самом API.
CLAMAV_HOST=
# Android-приложение (apps/android): /.well-known/assetlinks.json.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=
# Готовые образы из реестра вместо сборки на сервере.
IMAGE_PREFIX=gamemarket
IMAGE_TAG=local
