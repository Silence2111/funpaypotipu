{
  "name": "@gamemarket/shared",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./topup": {
      "types": "./dist/topup.d.ts",
      "default": "./dist/topup.js"
    },
    "./payment": {
      "types": "./dist/payment.d.ts",
      "default": "./dist/payment.js"
    },
    "./demo": {
      "types": "./dist/demo.d.ts",
      "default": "./dist/demo.js"
    },
    "./quantity": {
      "types": "./dist/quantity.d.ts",
      "default": "./dist/quantity.js"
    },
    "./notify": {
      "types": "./dist/notify.d.ts",
      "default": "./dist/notify.js"
    },
    "./buyer-data": {
      "types": "./dist/buyer-data.d.ts",
      "default": "./dist/buyer-data.js"
    },
    "./lot-stats": {
      "types": "./dist/lot-stats.d.ts",
      "default": "./dist/lot-stats.js"
    },
    "./sale": {
      "types": "./dist/sale.d.ts",
      "default": "./dist/sale.js"
    },
    "./saved-search": {
      "types": "./dist/saved-search.d.ts",
      "default": "./dist/saved-search.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@gamemarket/config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
